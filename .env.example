# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example) - LUPOL MOTOS
# Copia este archivo como .env y edita los valores correspondientes
# ==============================================================================
# Entorno de ejecución: development | production
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# SERVIDOR BACKEND (FastAPI / Uvicorn)
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# Clave secreta para firma criptográfica de cookies de sesión (HMAC SHA-256)
# Para generar una clave aleatoria en Python:
# python -c "import secrets; print(secrets.token_hex(32))"
LUPOL_SECRET=tu_clave_secreta_aleatoria_hex_de_64_caracteres

# Superadministrador inicial (se registra automáticamente al iniciar si no existe uno)
# Usuario: 3-40 caracteres | Contraseña: mínimo 8 caracteres
LUPOL_SUPER_USER=admin
LUPOL_SUPER_PASS=tu_clave_segura_min_8_caracteres

# Seguridad de cookies de sesión:
# false = Desarrollo local HTTP
# true  = Producción con certificado SSL / HTTPS
LUPOL_HTTPS=false

# ------------------------------------------------------------------------------
# SERVIDOR FRONTEND (React + Vite)
# ------------------------------------------------------------------------------
VITE_PORT=3000
VITE_BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# ATENCIÓN Y CONTACTO COMERCIAL
# ------------------------------------------------------------------------------
# Número oficial de WhatsApp de Lupol Motos Tacna (código 51 + celular)
WHATSAPP_NUMERO=51980687475
